<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Danh sách Người dùng</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
            rel="stylesheet">
    </head>
    <body>
        <div class="container mt-4">
            <h1 class="text-center mb-4">📋 Danh sách Người dùng</h1>

            <!-- Nút thêm người dùng -->
            <div class="d-flex justify-content-end mb-3">
                <a href="/users/create" class="btn btn-success">➕ Thêm Người
                    dùng</a>
            </div>

            <!-- Bảng hiển thị người dùng -->
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Họ</th>
                        <th>Tên</th>
                        <th>Email</th>
                        <th>Tuổi</th>
                        <th>Thành phố</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(user) { %>
                    <tr>
                        <td><%= user._id %></td>
                        <td><%= user.lastName %></td>
                        <td><%= user.firstName %></td>
                        <td><%= user.email %></td>
                        <td><%= user.age %></td>
                        <td><%= user.address %></td>
                        <td class="text-center">
                            <a href="/users/edit/<%= user._id %>"
                                class="btn btn-warning">✏️ Sửa</a>

                            <form action="/users/delete/<%= user._id %>"
                                method="GET" style="display: inline;">
                                <button type="submit" class="btn btn-danger">🗑️
                                    Xóa</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>

            <!-- Thông báo nếu không có người dùng -->
            <% if (users.length === 0) { %>
            <p class="text-center mt-4">🚫 Hiện tại không có người dùng nào.</p>
            <% } %>
        </div>

        <!-- JavaScript xác nhận xóa -->
        <script>
        document.querySelectorAll('.btn-danger').forEach(button => {
            button.addEventListener('click', (e) => {
                if (!confirm('Bạn có chắc muốn xóa người dùng này?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
    </body>
</html>
